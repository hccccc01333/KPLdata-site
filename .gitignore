# wrangler 部署临时目录
.wrangler/

# 构建临时文件
*.js.tmp
*.tmp
__pycache__/
*.pyc
# 系统文件
Thumbs.db
.DS_Store

# 复盘构建缓存
assets/replay/.manifest.json

# 浏览器无头测试的临时 profile（测试脚本用 --user-data-dir 生成，勿入库）
.edge-tmp*/

# Internal documentation stays local.
/*.md
!/README.md
/docs/
/design/
/designs/
/planning/
/notes/
*.docx
*.fig
*.sketch
